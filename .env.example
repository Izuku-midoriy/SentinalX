# ==============================================================================
# SentinelX Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
# Never commit .env or genuine production credentials.

# Application Environment
APP_ENV=development
SERVER_PORT=8085

# PostgreSQL Configuration
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_PORT=5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/sentinelx

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8085/api/v1
